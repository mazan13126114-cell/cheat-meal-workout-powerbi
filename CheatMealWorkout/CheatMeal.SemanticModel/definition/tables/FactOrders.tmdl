table FactOrders
	lineageTag: 450f61aa-10a9-4bc8-9ba1-bbd904aeb448

	measure 'Total Orders' = COUNTROWS ( FactOrders )
		formatString: #,0
		displayFolder: Basics
		lineageTag: 22036d83-a1fd-44f0-b93b-f14a98811218

	measure 'Avg Calories' = AVERAGE ( FactOrders[Calories] )
		formatString: #,0
		displayFolder: Basics
		lineageTag: 123abe12-62af-4671-b559-9ad0315786e4

	measure 'Avg Sodium (mg)' = AVERAGE ( FactOrders[Sodium (mg)] )
		formatString: #,0
		displayFolder: Basics
		lineageTag: 4e99ffac-f2ef-46cd-9cf3-b477ed9c87b3

	measure 'Avg Sugar (g)' = AVERAGE ( FactOrders[Sugar (g)] )
		formatString: #,0
		displayFolder: Basics
		lineageTag: eb6c9cb2-e3f6-49c2-a87f-a96b1ab332ce

	measure 'Avg Walking Min' = AVERAGE ( FactOrders[Walking (min)] )
		formatString: #,0
		displayFolder: Workout cost
		lineageTag: 55213ca3-1e8a-44e5-a9e6-dcfbfe940b2d

	measure 'Avg Cycling Min' = AVERAGE ( FactOrders[Cycling (min)] )
		formatString: #,0
		displayFolder: Workout cost
		lineageTag: a8c4e3dc-8204-44ec-8110-0f2bc9667559

	measure 'Avg Running Min' = AVERAGE ( FactOrders[Running (min)] )
		formatString: #,0
		displayFolder: Workout cost
		lineageTag: fd66081d-5bca-428f-b042-fe17e7cbb67e

	measure 'Avg HIIT Min' = AVERAGE ( FactOrders[HIIT (min)] )
		formatString: #,0
		displayFolder: Workout cost
		lineageTag: ef870b8e-1165-4098-9c94-e75f082e7f78

	measure 'Avg Running Hours' = DIVIDE ( [Avg Running Min], 60 )
		formatString: 0.0
		displayFolder: Workout cost
		lineageTag: 39bd45be-cf70-43e6-ab97-1b1f1126e517

	measure '% Meals Over Daily Limit' =
			DIVIDE (
			    CALCULATE ( [Total Orders], FactOrders[% of Daily Calories] >= 100 ),
			    [Total Orders]
			)
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: ffdd57c7-6cbf-4927-b842-35d9de1c28ea

	measure '% Meals Over Sodium Limit' =
			DIVIDE (
			    CALCULATE ( [Total Orders], FactOrders[Sodium (mg)] > 2300 ),
			    [Total Orders]
			)
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: 080cf442-d0d1-4849-a321-4380a8733b79

	measure '% of All Orders' = DIVIDE ( [Total Orders], CALCULATE ( [Total Orders], ALL ( FactOrders ) ) )
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: b9518690-81a6-4595-b54e-6a95717924c4

	measure 'Running Min vs Average' =
			VAR AllAvg = CALCULATE ( [Avg Running Min], ALL ( FactOrders ) )
			RETURN DIVIDE ( [Avg Running Min] - AllAvg, AllAvg )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparison
		lineageTag: d31685bc-9fb1-4878-b520-ee3e8dfdbb8e

